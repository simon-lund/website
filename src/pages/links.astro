---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LinkCard from '../components/LinkCard.astro';
import FilterableList from '../components/FilterableList.svelte';

const links = (await getCollection('links')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

function formatDate(date: Date): string {
	return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
}

const allTags = [...new Set(links.flatMap((l) => l.data.tags ?? []))].sort();
---

<BaseLayout title="Links" description="Articles, tools, and ideas worth sharing.">
	<section class="max-w-2xl mx-auto px-4 py-16">
		<h1 class="text-2xl sm:text-3xl font-bold mb-4" style="font-family: var(--font-heading);">Links</h1>
		<p class="text-ink-light mb-8">Articles, talks, and tools I've found worth thinking about.</p>

		<FilterableList client:load items={links.map(l => ({ tags: l.data.tags ?? [] }))} tags={allTags}>
			<div class="space-y-6">
				{links.map((link) => (
					<LinkCard
						href={link.data.url}
						title={link.data.title}
						description={link.data.comment}
						tag={link.data.tags?.[0]}
						date={formatDate(link.data.pubDate)}
						tags={link.data.tags}
						external
					/>
				))}
			</div>
		</FilterableList>
	</section>
</BaseLayout>
