---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" description="This page doesn't exist.">
	<section class="max-w-2xl mx-auto px-4 py-32 text-center">
		<h1 class="text-5xl sm:text-6xl font-bold mb-4" style="font-family: var(--font-heading);">404</h1>
		<p class="text-lg text-ink-light mb-8">This page doesn't exist. Maybe it never did.</p>
		<a href="/" class="text-accent hover:text-accent-hover transition-colors font-medium">Go home</a>
	</section>
</BaseLayout>
