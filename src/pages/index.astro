---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroText from '../components/HeroText.svelte';
import LinkCard from '../components/LinkCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="-mt-[5.25rem] min-h-[60vh] md:min-h-[70vh] flex items-center justify-center px-4 pt-32 pb-16 relative bg-cream-dark">
		<HeroText client:load />
	</section>

	<section class="max-w-2xl mx-auto px-4 pt-20 pb-16">
		<h2 class="text-3xl sm:text-4xl font-bold mb-4" style="font-family: var(--font-heading);">Hi, I'm Simon</h2>

		<p class="text-lg text-ink-light leading-relaxed mb-4">
			I write code to think. Most of what I know came from making things, breaking them, and trying again. Lately, three questions drive my work:
		</p>

		<ul class="list-disc pl-6 space-y-2 text-lg text-ink-light leading-relaxed marker:text-accent">
			<li><strong class="text-ink">Where AI lives</strong> Exploring how intelligence becomes part of the interface itself — not a feature you open, but something you feel.</li>
			<li><strong class="text-ink">What makes AI useful</strong> Software that does the right thing quietly — not one that makes suggestions you constantly have to fix.</li>
			<li><strong class="text-ink">What makes AI trustworthy</strong> Building systems that are transparent, predictable, and honest about what they can and can't do.</li>
		</ul>
	</section>

	<section class="max-w-2xl mx-auto px-4 pb-16 pt-8">
		<h2 class="text-3xl sm:text-4xl font-bold mb-4" style="font-family: var(--font-heading);">Recent writing</h2>

		<div class="space-y-6">
			<LinkCard href="#" title="Post Title" tag="Post" date="2026" />
			<LinkCard href="#" title="Another Post" tag="Post" date="2025" />
		</div>

		<div class="mt-6">
			<a href="/blog" class="text-sm font-medium hover:text-accent-hover transition-colors">See all</a>
		</div>
	</section>
</BaseLayout>
