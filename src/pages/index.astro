---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroText from '../components/HeroText.svelte';
import ScrollHint from '../components/ScrollHint.svelte';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="min-h-screen flex items-center justify-center px-4 relative">
		<HeroText client:load />
		<ScrollHint client:visible />
	</section>

	<section class="max-w-2xl mx-auto px-4 pb-32">
		<h2 class="text-3xl font-bold mb-6" style="font-family: var(--font-heading);">Hi, I'm Simon</h2>

		<p class="text-ink-light leading-relaxed text-lg mb-8">
			I'm a developer and UX designer based in Europe, focused on making AI more human.
		</p>

		<ul class="list-disc pl-6 space-y-4 text-ink-light leading-relaxed text-lg marker:text-accent">
			<li><strong class="text-ink">AI beyond the chatbot</strong> Exploring how intelligence becomes part of the interface itself — not a feature you open, but something you feel.</li>
			<li><strong class="text-ink">Learning by building</strong> I write code to think. Most of what I know came from making things, breaking them, and trying again.</li>
			<li><strong class="text-ink">Calm software</strong> Making tools that respect your attention and get out of the way.</li>
		</ul>

		<div class="mt-12 text-sm text-stone">
			<a href="mailto:mail@simon-lund.de" class="hover:text-ink transition-colors">mail@simon-lund.de</a>
		</div>
	</section>
</BaseLayout>
