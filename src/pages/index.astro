---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroText from '../components/HeroText.svelte';
import ListItem from '../components/ListItem.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getBlogUrl } from '../lib/blog';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="-mt-[5.25rem] min-h-[60vh] md:min-h-[70vh] flex items-center justify-center px-4 pt-32 pb-16 relative bg-cream-dark">
		<HeroText client:load />
	</section>

	{posts.length > 0 && (
		<section class="max-w-2xl mx-auto px-4 pt-20 pb-16">
			<h2 class="text-2xl sm:text-3xl font-bold mb-4" style="font-family: var(--font-heading);">Writing</h2>

			<div class="space-y-1">
				{posts.map((post) => (
					<ListItem
						href={getBlogUrl(post.id, post.data.title)}
						title={post.data.title}
						description={post.data.description}
					/>
				))}
			</div>

			<div class="mt-6">
				<a href="/blog" class="text-sm font-medium hover:text-accent-hover transition-colors">See all</a>
			</div>
		</section>
	)}
</BaseLayout>
