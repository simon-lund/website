---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getBlogUrl } from '../../lib/blog';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="Blog" description="Thoughts on AI, web development, and building useful things.">
	<section class="max-w-2xl mx-auto px-4 py-16">
		<h1 class="text-4xl font-bold mb-12" style="font-family: var(--font-heading);">Writing</h1>

		<ul class="space-y-10">
			{posts.map((post) => (
				<li>
					<a href={getBlogUrl(post.id, post.data.title)} class="group block card-hover">
						<p class="text-sm text-stone mb-1">
							<FormattedDate date={post.data.pubDate} />
						</p>
						<h2
							class="text-xl font-semibold group-hover:text-accent transition-colors duration-200"
							style="font-family: var(--font-heading);"
						>
							{post.data.title}
						</h2>
						<p class="text-ink-light mt-1">{post.data.description}</p>
					</a>
				</li>
			))}
		</ul>
	</section>
</BaseLayout>
