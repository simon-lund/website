---
import BaseLayout from '../layouts/BaseLayout.astro';
import PixelPlayground from '../components/PixelPlayground.svelte';
---

<BaseLayout title="Pixel test" description="Pixelation + explosion playground.">
	<section class="max-w-3xl mx-auto px-4 py-16">
		<h1 class="text-2xl sm:text-3xl font-bold mb-2" style="font-family: var(--font-heading);">Pixel playground</h1>
		<p class="text-ink-light mb-10">
			A real photo, pixelated on a canvas, then shattered with physics. Click the image to
			explode it, <em>Reparo</em> to glide it back. Tune the sliders to taste.
		</p>

		<PixelPlayground client:only="svelte" />
	</section>
</BaseLayout>
