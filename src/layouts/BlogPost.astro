---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import CopyLinkButton from '../components/CopyLinkButton.svelte';
import ReadingFocus from '../components/ReadingFocus.svelte';
import BackButton from '../components/BackButton.svelte';
import RocketFab from '../components/RocketFab.svelte';

type Props = CollectionEntry<'blog'>['data'] & { minutesRead?: string };

const { title, description, pubDate, updatedDate, tags, minutesRead, draft } = Astro.props;
const kicker = tags?.[0];
---

<BaseLayout title={title} description={description} noindex={draft}>
	<article class="max-w-2xl mx-auto px-4 pt-20 pb-16">
		<header class="mb-12">
			<div class="mb-8">
				<BackButton client:load />
			</div>

			{draft && (
				<div class="mb-4 inline-flex items-center gap-1.5 rounded-full bg-accent px-3 py-1 text-xs font-semibold uppercase tracking-[0.08em] text-white">
					Draft
				</div>
			)}

			{kicker && (
				<span class="inline-block text-xs font-semibold uppercase tracking-[0.08em] text-accent mb-4">
					{kicker}
				</span>
			)}

			<h1 class="text-4xl sm:text-5xl font-bold tracking-tight" style="font-family: var(--font-heading); line-height: 1.08;">
				{title}
			</h1>

			{description && (
				<p class="mt-5 text-lg sm:text-xl text-ink-light leading-relaxed max-w-xl">
					{description}
				</p>
			)}

			<div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-3 mt-7 text-sm text-stone">
				<div class="flex items-center gap-3">
					<FormattedDate date={pubDate} />
					{updatedDate && (
						<span class="italic">(updated <FormattedDate date={updatedDate} />)</span>
					)}
					{minutesRead && (
						<>
							<span class="text-stone-light">·</span>
							<span>{minutesRead}</span>
						</>
					)}
				</div>
				<span class="hidden sm:inline text-stone-light">·</span>
				<div class="flex items-center gap-3">
					<CopyLinkButton client:load />
					<ReadingFocus client:load />
				</div>
			</div>
		</header>

		<div class="prose">
			<slot />
		</div>
	</article>

	<RocketFab client:load />
</BaseLayout>
