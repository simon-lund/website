---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import CopyLinkButton from '../components/CopyLinkButton.svelte';
import BackButton from '../components/BackButton.svelte';
import RocketFab from '../components/RocketFab.svelte';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate } = Astro.props;
---

<BaseLayout title={title} description={description}>
	<article class="max-w-2xl mx-auto px-4 py-16">
		<header class="mb-12">
			<div class="flex items-center justify-between mb-4">
				<div class="flex items-center gap-4">
					<BackButton client:load />
					<div class="text-sm text-stone">
						<FormattedDate date={pubDate} />
						{updatedDate && (
							<span class="ml-2 italic">
								(updated <FormattedDate date={updatedDate} />)
							</span>
						)}
					</div>
				</div>
				<CopyLinkButton client:load />
			</div>
			<h1 class="text-3xl sm:text-4xl font-bold leading-tight" style="font-family: var(--font-heading);">
				{title}
			</h1>
		</header>

		<div class="prose">
			<slot />
		</div>
	</article>

	<RocketFab client:load />
</BaseLayout>
