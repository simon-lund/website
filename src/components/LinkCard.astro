---
interface Props {
	href: string;
	title: string;
	description?: string;
	external?: boolean;
	tag?: string;
	date?: string;
	tags?: string[];
}

const { href, title, description, external = false, tag, date, tags = [] } = Astro.props;

---

<div data-tags={tags.join(',')}>
	<a
		href={href}
		target={external ? '_blank' : undefined}
		rel={external ? 'noopener noreferrer' : undefined}
		class="group block cursor-pointer rounded-xl overflow-hidden transition-transform duration-200 hover:scale-[1.01]"
		style="background-color: var(--color-accent-light);"
	>
		<div class="flex items-center justify-between gap-3 px-4 sm:px-5 py-4 sm:py-5" style="min-height: 88px;">
			<div class="min-w-0">
				<p class="text-lg sm:text-xl font-bold text-ink leading-snug" style="font-family: var(--font-heading);">{title}</p>
				{description && <p class="text-sm text-ink-light mt-1 leading-relaxed">{description}</p>}
				{(tag || date) && (
					<div class="flex items-center gap-1.5 mt-1.5">
						{tag && <span class="text-xs text-stone">{tag}</span>}
						{tag && date && <span class="text-stone-light">&middot;</span>}
						{date && <span class="text-xs text-stone">{date}</span>}
					</div>
				)}
			</div>
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-stone-light group-hover:text-ink group-hover:translate-x-1 transition-all duration-200 shrink-0"><path d="m9 18 6-6-6-6"/></svg>
		</div>
	</a>
</div>
