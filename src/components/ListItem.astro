---
interface Props {
	href: string;
	title: string;
	description?: string;
	external?: boolean;
	tags?: string[];
}

const { href, title, description, external = false, tags = [] } = Astro.props;
---

<div data-tags={tags.join(',')}>
	<a
		href={href}
		target={external ? '_blank' : undefined}
		rel={external ? 'noopener noreferrer' : undefined}
		class="group flex items-center justify-between gap-4 -mx-3 px-3 py-2.5 rounded-lg transition-colors duration-200 hover:bg-cream-dark"
	>
		<div class="min-w-0">
			<span class="font-medium text-ink">{title}</span>
			{description && <span class="text-ink-light ml-1.5">{description}</span>}
		</div>
		<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-stone-light opacity-0 group-hover:opacity-100 shrink-0 transition-opacity duration-200"><path d="m9 18 6-6-6-6"/></svg>
	</a>
</div>
